  "id": "rhodey_wants_to_draw",
  "shortTitle": {
    "en": "Let's Draw!",
    "id": "Ayo Menggambar!"
  },
  "title": {
    "en": "Make Rhodey Want to Draw",
    "id": "Membuat Rhodey Mau Menggambar"
  },
  "description": {
    "en": "Rhodey is sitting in the classroom but does not feel ready to draw. He is close to the activity, yet his body language shows that he needs emotional safety before he can enjoy the drawing materials.",
    "id": "Rhodey duduk di kelas tetapi belum merasa siap untuk menggambar. Ia dekat dengan aktivitasnya, tetapi bahasa tubuhnya menunjukkan bahwa ia butuh rasa aman sebelum bisa menikmati alat gambar."
  },
  "completionSummary": {
    "en": "Rhodey needed to feel noticed before he could join in. Sitting with him first made the invitation to draw feel safe.",
    "id": "Rhodey perlu merasa diperhatikan sebelum ia bisa ikut beraktivitas. Duduk menemaninya terlebih dahulu membuat ajakan untuk menggambar terasa aman."
  },
  "completionTip": {
    "en": "Before asking a hesitant child to join an activity, sit with them first. Let them feel your presence before you invite them in.",
    "id": "Sebelum mengajak anak yang masih ragu untuk mengikuti aktivitas, duduklah bersamanya terlebih dahulu. Biarkan ia merasakan kehadiranmu sebelum mengajaknya ikut."
  },
  "hints": [
    {
      "en": "A child may join an activity more easily after feeling noticed and accompanied.",
      "id": "Anak sering lebih mudah ikut aktivitas setelah merasa diperhatikan dan ditemani."
    }
  ],
